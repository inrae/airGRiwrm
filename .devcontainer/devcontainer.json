{
	"image": "rocker/verse:latest",
	"customizations": {
		"vscode": {
			"extensions": [
				"eamodio.gitlens",
				"REditorSupport.r"
			]
		}
	},
	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "R -q -e 'install.packages(\"pak\")'",
	"postStartCommand": "R -q -e 'pak::local_install()'"
}
